msgstr "Indique aux moteurs de recherche la langue (et éventuellement la région) de ces pages, par ex. « %s ». Utilisé aussi pour <html lang>."

#: includes/admin/class-admin-languages.php:119
msgid "Tagline"
msgstr "Slogan"

#: includes/admin/class-admin-languages.php:122
msgid "Short slogan in this language. Empty = the WordPress tagline (Settings › General)."
msgstr "Slogan court dans cette langue. Vide = le slogan WordPress (Réglages › Général)."

#: includes/admin/class-admin-languages.php:123
msgid "Short slogan in this language. Leave empty rather than showing a Vietnamese tagline on foreign pages."
msgstr "Slogan court dans cette langue. Laissez vide plutôt que d’afficher un slogan vietnamien sur les pages étrangères."

