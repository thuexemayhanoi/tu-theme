#: includes/admin/class-admin-business.php:516
#: includes/admin/class-admin-dashboard.php:325
msgid "Backup & restore"
msgstr "Sicherung & Wiederherstellung"

#: includes/admin/class-admin-business.php:516
msgid "A backup of store information and prices is made automatically before every change. Download a copy before big changes."
msgstr "Vor jeder Änderung wird automatisch eine Sicherung der Geschäftsdaten und Preise angelegt. Laden Sie vor großen Änderungen eine Kopie herunter."

#: includes/admin/class-admin-business.php:521
#: includes/admin/class-admin-dashboard.php:324
msgid "Download backup (JSON)"
msgstr "Sicherung herunterladen (JSON)"

#: includes/admin/class-admin-business.php:527
msgid "Import a backup file"
msgstr "Sicherungsdatei importieren"

#: includes/admin/class-admin-business.php:529
msgid "JSON file, maximum 200 KB. The current data is backed up first, so you can undo the import below."
msgstr "JSON-Datei, maximal 200 KB. Die aktuellen Daten werden zuerst gesichert, sodass Sie den Import unten rückgängig machen können."

#: includes/admin/class-admin-business.php:530
msgid "Replace the store information and prices with the content of this file?"
msgstr "Geschäftsdaten und Preise durch den Inhalt dieser Datei ersetzen?"

#: includes/admin/class-admin-business.php:530
msgid "Import"
msgstr "Importieren"

#: includes/admin/class-admin-business.php:534
msgid "History"
msgstr "Verlauf"

#: includes/admin/class-admin-business.php:536
