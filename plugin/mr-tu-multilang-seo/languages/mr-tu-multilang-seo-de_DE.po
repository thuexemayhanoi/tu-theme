#: includes/admin/class-admin-languages.php:41
#: includes/admin/class-admin-languages.php:42
#: includes/admin/class-admin-languages.php:62
#: includes/class-translations.php:182
msgid "Languages"
msgstr "Sprachen"

#: includes/admin/class-admin-languages.php:63
msgid "Vietnamese is the default language at “/”. Other languages live under their own prefix, for example “/en/”. Turning a language off hides it everywhere but keeps its content."
msgstr "Vietnamesisch ist die Standardsprache unter „/“. Andere Sprachen liegen unter ihrem eigenen Präfix, zum Beispiel „/en/“. Wird eine Sprache ausgeschaltet, ist sie überall ausgeblendet, ihre Inhalte bleiben aber erhalten."

#. translators: 1: native language name, 2: language code.
#: includes/admin/class-admin-languages.php:70
#, php-format
msgid "%1$s (%2$s)"
msgstr "%1$s (%2$s)"

#: includes/admin/class-admin-languages.php:75
msgid "Default language: always on, served at the site root without a prefix."
msgstr "Standardsprache: immer aktiv, wird im Stammverzeichnis der Website ohne Präfix ausgeliefert."

#: includes/admin/class-admin-languages.php:79
msgid "Show this language on the website"
msgstr "Diese Sprache auf der Website anzeigen"

#: includes/admin/class-admin-languages.php:81
msgid "When off, its addresses return “not found” and it disappears from the language switcher, hreflang and sitemaps. Nothing is deleted."
msgstr "Wenn ausgeschaltet, liefern ihre Adressen „nicht gefunden“, und sie verschwindet aus Sprachumschalter, hreflang und Sitemaps. Es wird nichts gelöscht."

#: includes/admin/class-admin-languages.php:86
msgid "URL prefix"
msgstr "URL-Präfix"

#. translators: %s: example address.
#: includes/admin/class-admin-languages.php:89
#, php-format
msgid "2–5 lowercase letters. Addresses look like %s"
msgstr "2–5 Kleinbuchstaben. Adressen sehen so aus: %s"

#: includes/admin/class-admin-languages.php:104
msgid "hreflang code"
msgstr "hreflang-Code"

#. translators: %s: language code.
#: includes/admin/class-admin-languages.php:107
#, php-format
msgid "Tells search engines the language (and optionally the region) of these pages, e.g. “%s”. Also used for <html lang>."
msgstr "Teilt Suchmaschinen die Sprache (und optional die Region) dieser Seiten mit, z. B. „%s“. Wird auch für <html lang> verwendet."

#: includes/admin/class-admin-languages.php:119
msgid "Tagline"
msgstr "Untertitel"

#: includes/admin/class-admin-languages.php:122
msgid "Short slogan in this language. Empty = the WordPress tagline (Settings › General)."
msgstr "Kurzer Slogan in dieser Sprache. Leer = der WordPress-Untertitel (Einstellungen › Allgemein)."

#: includes/admin/class-admin-languages.php:123
msgid "Short slogan in this language. Leave empty rather than showing a Vietnamese tagline on foreign pages."
msgstr "Kurzer Slogan in dieser Sprache. Lieber leer lassen, als auf fremdsprachigen Seiten einen vietnamesischen Untertitel zu zeigen."

#: includes/admin/class-admin-languages.php:135
msgid "Fallback language for other visitors (x-default)"
msgstr "Ausweichsprache für andere Besucher (x-default)"

#: includes/admin/class-admin-languages.php:136
msgid "Search engines send visitors whose language is not offered to this version."
msgstr "Suchmaschinen leiten Besucher, deren Sprache nicht angeboten wird, auf diese Version."

#: includes/admin/class-admin-languages.php:139
msgid "x-default language"
msgstr "x-default-Sprache"

#: includes/admin/class-admin-languages.php:141
msgid "None (do not output x-default)"
msgstr "Keine (kein x-default ausgeben)"

#: includes/admin/class-admin-languages.php:166
msgid "Off"
msgstr "Aus"

#: includes/admin/class-admin-languages.php:170
msgid "Home page published"
msgstr "Startseite veröffentlicht"

#: includes/admin/class-admin-languages.php:171
msgid "No published home page: its home address returns “not found”"
msgstr "Keine veröffentlichte Startseite: ihre Startadresse liefert „nicht gefunden“"

