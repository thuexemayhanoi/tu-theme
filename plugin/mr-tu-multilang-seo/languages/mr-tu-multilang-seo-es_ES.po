#: includes/admin/class-admin-languages.php:41
#: includes/admin/class-admin-languages.php:42
#: includes/admin/class-admin-languages.php:62
#: includes/class-translations.php:182
msgid "Languages"
msgstr "Idiomas"

#: includes/admin/class-admin-languages.php:63
msgid "Vietnamese is the default language at “/”. Other languages live under their own prefix, for example “/en/”. Turning a language off hides it everywhere but keeps its content."
msgstr "El vietnamita es el idioma predeterminado en «/». Los demás idiomas viven bajo su propio prefijo, por ejemplo «/en/». Desactivar un idioma lo oculta en todas partes pero conserva su contenido."

#. translators: 1: native language name, 2: language code.
#: includes/admin/class-admin-languages.php:70
#, php-format
msgid "%1$s (%2$s)"
msgstr "%1$s (%2$s)"

#: includes/admin/class-admin-languages.php:75
msgid "Default language: always on, served at the site root without a prefix."
msgstr "Idioma predeterminado: siempre activo, se sirve en la raíz del sitio sin prefijo."

#: includes/admin/class-admin-languages.php:79
msgid "Show this language on the website"
msgstr "Mostrar este idioma en la web"

#: includes/admin/class-admin-languages.php:81
msgid "When off, its addresses return “not found” and it disappears from the language switcher, hreflang and sitemaps. Nothing is deleted."
msgstr "Cuando está desactivado, sus direcciones devuelven «no encontrado» y desaparece del selector de idioma, de hreflang y de los sitemaps. No se borra nada."

#: includes/admin/class-admin-languages.php:86
msgid "URL prefix"
msgstr "Prefijo de URL"

#. translators: %s: example address.
#: includes/admin/class-admin-languages.php:89
#, php-format
msgid "2–5 lowercase letters. Addresses look like %s"
msgstr "De 2 a 5 letras minúsculas. Las direcciones quedan así: %s"

#: includes/admin/class-admin-languages.php:104
msgid "hreflang code"
msgstr "Código hreflang"

#. translators: %s: language code.
#: includes/admin/class-admin-languages.php:107
#, php-format
msgid "Tells search engines the language (and optionally the region) of these pages, e.g. “%s”. Also used for <html lang>."
msgstr "Indica a los buscadores el idioma (y opcionalmente la región) de estas páginas, p. ej. «%s». También se usa para <html lang>."

#: includes/admin/class-admin-languages.php:119
msgid "Tagline"
msgstr "Descripción corta"

#: includes/admin/class-admin-languages.php:122
msgid "Short slogan in this language. Empty = the WordPress tagline (Settings › General)."
msgstr "Eslogan corto en este idioma. Vacío = la descripción corta de WordPress (Ajustes › Generales)."

#: includes/admin/class-admin-languages.php:123
msgid "Short slogan in this language. Leave empty rather than showing a Vietnamese tagline on foreign pages."
msgstr "Eslogan corto en este idioma. Mejor déjalo vacío que mostrar una descripción corta en vietnamita en páginas de otros idiomas."

#: includes/admin/class-admin-languages.php:135
msgid "Fallback language for other visitors (x-default)"
msgstr "Idioma alternativo para el resto de visitantes (x-default)"

#: includes/admin/class-admin-languages.php:136
msgid "Search engines send visitors whose language is not offered to this version."
msgstr "Los buscadores envían a esta versión a los visitantes cuyo idioma no se ofrece."

#: includes/admin/class-admin-languages.php:139
msgid "x-default language"
msgstr "Idioma x-default"

#: includes/admin/class-admin-languages.php:141
msgid "None (do not output x-default)"
msgstr "Ninguno (no emitir x-default)"

#: includes/admin/class-admin-dashboard.php:212
#: includes/admin/class-admin-languages.php:166
msgid "Off"
msgstr "Desactivado"

#: includes/admin/class-admin-languages.php:170
msgid "Home page published"
msgstr "Página de inicio publicada"

#: includes/admin/class-admin-languages.php:171
msgid "No published home page: its home address returns “not found”"
msgstr "Sin página de inicio publicada: su dirección de inicio devuelve «no encontrado»"

#. translators: %s: number of published pages and posts.
#: includes/admin/class-admin-languages.php:175
#, php-format
msgid "%s published page/post"
msgid_plural "%s published pages/posts"
msgstr[0] "%s página/entrada publicada"
msgstr[1] "%s páginas/entradas publicadas"

#. translators: %s: list of validation errors.
#: includes/admin/class-admin-languages.php:224
#, php-format
msgid "Saved, except: %s"
msgstr "Guardado, excepto: %s"

#: includes/admin/class-admin-languages.php:226
msgid "Language settings saved."
msgstr "Ajustes de idioma guardados."

#: includes/admin/class-admin-dashboard.php:162
#: includes/admin/class-admin-pricing.php:43
#: includes/admin/class-admin-pricing.php:44
#: includes/admin/class-admin-pricing.php:88
#: includes/class-roles.php:72
msgid "Prices"
msgstr "Precios"

#: includes/admin/class-admin-pricing.php:88
msgid "Rental prices and deposits per model. Unconfirmed prices never appear as fact: visitors see “Price on request” and a call button instead."
msgstr "Precios de alquiler y fianzas por modelo. Los precios sin confirmar nunca aparecen como un hecho: los visitantes ven «Precio a consultar» y un botón de llamada en su lugar."

#: includes/admin/class-admin-dashboard.php:160
#: includes/admin/class-admin-pricing.php:95
msgid "Price list"
msgstr "Lista de precios"

#: includes/admin/class-admin-pricing.php:95
msgid "Confirm the price list only after checking the real prices at the Mr Tu location."
msgstr "Confirma la lista de precios solo después de comprobar los precios reales en el local de Mr Tu."

#: includes/admin/class-admin-pricing.php:96
msgid "Price list confirmed"
msgstr "Lista de precios confirmada"

#: includes/admin/class-admin-pricing.php:97
msgid "Prices confirmed for Mr Tu"
msgstr "Precios confirmados para Mr Tu"

#: includes/admin/class-admin-pricing.php:97
msgid "A model’s price is shown on the website only when this switch AND the model’s own switch below are on."
msgstr "El precio de un modelo se muestra en la web solo cuando este interruptor Y el interruptor propio del modelo, más abajo, están activados."

#: includes/admin/class-admin-pricing.php:101
msgid "Date you last checked the prices"
msgstr "Fecha de la última comprobación de los precios"

#: includes/admin/class-admin-pricing.php:104
msgid "Shown as “Updated …” above the price table."
msgstr "Se muestra como «Actualizado el…» encima de la tabla de precios."

#: includes/admin/class-admin-pricing.php:109
msgid "Show reference prices while not confirmed"
msgstr "Mostrar precios orientativos mientras no estén confirmados"

#: includes/admin/class-admin-pricing.php:109
msgid "On: unconfirmed prices appear with the label “reference price, confirm before booking”. Off: they appear as “Price on request”."
msgstr "Activado: los precios sin confirmar aparecen con la etiqueta «precio orientativo, confirmar antes de reservar». Desactivado: aparecen como «Precio a consultar»."

#: includes/admin/class-admin-pricing.php:113
msgid "Where the reference prices come from (only visible here)"
msgstr "De dónde salen los precios orientativos (solo visible aquí)"

#: includes/admin/class-admin-pricing.php:121
msgid "Delivery fee"
msgstr "Tarifa de entrega"

#: includes/admin/class-admin-pricing.php:122
#: includes/admin/class-admin-pricing.php:126
msgid "Delivery / pick-up fee"
msgstr "Tarifa de entrega / recogida"

#: includes/admin/class-admin-pricing.php:128
msgid "Short text, for example: free delivery inside the Old Quarter."
msgstr "Texto corto, por ejemplo: entrega gratuita dentro del Casco Antiguo."

#: includes/admin/class-admin-pricing.php:137
msgid "Prices per model"
msgstr "Precios por modelo"

#: includes/admin/class-admin-pricing.php:137
msgid "Amounts in VND without dots, for example 150000. Leave “to” empty for a single price, and both empty when there is no price."
msgstr "Importes en VND sin puntos, por ejemplo 150000. Deja «hasta» vacío para un precio único, y ambos vacíos cuando no hay precio."

#: includes/admin/class-admin-pricing.php:139
