#: patterns/home-contact.php
msgctxt "Pattern description"
msgid "Dark closing band with the Mr Tu contact card and call button (both read the verified business data from the plugin)."
msgstr "Dải kết tối màu với thẻ liên hệ Mr Tu và nút gọi (cả hai đọc dữ liệu cửa hàng đã xác minh từ plugin)."

#: patterns/home-contact.php:17
msgid "Ready when you are"
msgstr "Sẵn sàng khi bạn cần"

#: patterns/home-contact.php:21
msgid "Call to check availability and arrange the hand-over."
msgstr "Gọi để kiểm tra xe còn trống và hẹn giao xe."

#: patterns/home-faq.php
msgctxt "Pattern title"
msgid "Home · FAQ"
msgstr "Trang chủ · Câu hỏi thường gặp"

#: patterns/home-faq.php
msgctxt "Pattern description"
msgid "Section title + intro and an accordion of questions (core Details blocks)."
msgstr "Tiêu đề phần + đoạn giới thiệu và danh sách câu hỏi xếp gọn (khối Details của WordPress)."

#: patterns/home-faq.php:17
msgid "Questions before you ride"
msgstr "Câu hỏi trước khi lên đường"

#: patterns/home-faq.php:21
msgid "The answers travellers ask for most often."
msgstr "Những câu trả lời du khách hay hỏi nhất."

#: patterns/home-faq.php:25
msgid "Which documents do I need?"
msgstr "Tôi cần những giấy tờ gì?"

#: patterns/home-faq.php:26
#: patterns/home-faq.php:32
msgid "Write the verified answer here."
msgstr "Viết câu trả lời đã xác minh vào đây."

#: patterns/home-faq.php:31
msgid "How does the deposit work?"
msgstr "Tiền cọc hoạt động thế nào?"

#: patterns/home-fleet.php
msgctxt "Pattern title"
msgid "Home · Fleet (bikes)"
msgstr "Trang chủ · Dàn xe"

#: patterns/home-fleet.php
msgctxt "Pattern description"
msgid "Section title + intro framing the Mr Tu fleet block (bikes come from the plugin's vehicle list)."
msgstr "Tiêu đề phần + đoạn giới thiệu bao quanh khối dàn xe Mr Tu (xe lấy từ danh sách xe của plugin)."

#: patterns/home-fleet.php:17
msgid "Pick your bike"
msgstr "Chọn xe của bạn"

#: patterns/home-fleet.php:21
msgid "Automatic scooters for the city, semi-automatics for longer rides."
msgstr "Xe tay ga để đi trong phố, xe số cho những chuyến đi xa hơn."

#: patterns/home-pricing.php
msgctxt "Pattern title"
msgid "Home · Pricing"
msgstr "Trang chủ · Bảng giá"

#: patterns/home-pricing.php
msgctxt "Pattern description"
msgid "Section title + intro framing the Mr Tu pricing table block (prices come from the plugin, one place for the whole site)."
msgstr "Tiêu đề phần + đoạn giới thiệu bao quanh khối bảng giá Mr Tu (giá lấy từ plugin, một nơi cho cả website)."

#: patterns/home-pricing.php:17
msgid "Prices by day, week or month"
msgstr "Giá theo ngày, tuần hoặc tháng"

#: patterns/home-pricing.php:21
msgid "Rental and deposit are always shown separately."
msgstr "Giá thuê và tiền cọc luôn được ghi riêng."

#: patterns/home-promise.php
msgctxt "Pattern title"
msgid "Home · Promise (why Mr Tu)"
msgstr "Trang chủ · Cam kết (vì sao chọn Mr Tu)"

#: patterns/home-promise.php
msgctxt "Pattern description"
msgid "Section title, short intro and three or four columns (H3 + text) shown with numbered kilometre stones."
msgstr "Tiêu đề phần, đoạn giới thiệu ngắn và ba hoặc bốn cột (H3 + chữ) hiển thị cùng các cột mốc cây số đánh số."

#: patterns/home-promise.php:17
msgid "Why ride with Mr Tu"
msgstr "Vì sao thuê xe ở Mr Tu"

#: patterns/home-promise.php:21
msgid "One short sentence on what makes renting here simple."
msgstr "Một câu ngắn về điều làm việc thuê xe ở đây đơn giản."

#: patterns/home-promise.php:27
msgid "Near the Old Quarter"
msgstr "Gần Phố Cổ"

#: patterns/home-promise.php:31
msgid "Explain where and how the hand-over happens."
msgstr "Giải thích giao xe ở đâu và như thế nào."

#: patterns/home-promise.php:37
msgid "Clear conditions"
msgstr "Điều kiện rõ ràng"

#: patterns/home-promise.php:41
msgid "Documents, deposit and return rules in plain words."
msgstr "Giấy tờ, tiền cọc và quy định trả xe nói bằng lời dễ hiểu."

#: patterns/home-promise.php:47
msgid "Help when you need it"
msgstr "Hỗ trợ khi bạn cần"

#: patterns/home-promise.php:51
msgid "What happens if the bike has a problem on the road."
msgstr "Điều gì xảy ra nếu xe gặp sự cố trên đường."

#: patterns/home-steps.php
msgctxt "Pattern title"
msgid "Home · Steps (how renting works)"
msgstr "Trang chủ · Các bước (thuê xe thế nào)"

#: patterns/home-steps.php
msgctxt "Pattern description"
msgid "Ordered list rendered as kilometre stones along a dashed road that fills with orange as you scroll. Start each item with a bold title."
msgstr "Danh sách có thứ tự hiển thị như các cột mốc cây số dọc con đường nét đứt, tô màu cam dần khi cuộn. Bắt đầu mỗi mục bằng một tiêu đề in đậm."

#: patterns/home-steps.php:17
msgid "How renting works"
msgstr "Thuê xe thế nào"

#: patterns/home-steps.php:22
msgid "Get in touch"
msgstr "Liên hệ"

#: patterns/home-steps.php:22
msgid "Tell us your dates and the bike you want."
msgstr "Cho chúng tôi biết ngày thuê và dòng xe bạn muốn."

#: patterns/home-steps.php:26
msgid "Confirm the details"
msgstr "Xác nhận chi tiết"

#: patterns/home-steps.php:26
msgid "Price, deposit and hand-over are agreed in advance."
msgstr "Giá, tiền cọc và cách giao xe được thống nhất trước."

#: patterns/home-steps.php:30
msgid "Check and ride"
msgstr "Kiểm tra và lên đường"

#: patterns/home-steps.php:30
msgid "Inspect the bike together, take the helmet and go."
msgstr "Cùng kiểm tra xe, nhận mũ bảo hiểm và đi."

#: patterns/home-steps.php:34
msgid "Return"
msgstr "Trả xe"

#: patterns/home-steps.php:34
msgid "Bring it back, get your deposit back."
msgstr "Mang xe về, nhận lại tiền cọc."

#: patterns/home-story.php
msgctxt "Pattern title"
msgid "Home · Story"
msgstr "Trang chủ · Câu chuyện"

#: patterns/home-story.php
msgctxt "Pattern description"
msgid "Editorial text block; the theme adds the Old Quarter map graphic (or the story photo from Theme settings) beside it."
msgstr "Khối chữ dạng biên tập; theme thêm hình bản đồ Phố Cổ (hoặc ảnh câu chuyện trong Cài đặt theme) bên cạnh."

#: patterns/home-story.php:17
msgid "Hanoi starts at Km 0"
msgstr "Hà Nội bắt đầu từ Km 0"

#: patterns/home-story.php:21
msgid "A short, true story about Mr Tu and the Old Quarter."
msgstr "Một câu chuyện ngắn và có thật về Mr Tu và Phố Cổ."

#: patterns/home-story.php:25
msgid "A second paragraph with practical detail visitors care about."
msgstr "Đoạn thứ hai với chi tiết thực tế mà khách quan tâm."

#: patterns/home-trust.php
msgctxt "Pattern title"
msgid "Home · Trust (facts)"
msgstr "Trang chủ · Tin cậy (sự thật)"

#: patterns/home-trust.php
msgctxt "Pattern description"
msgid "Fact cards from a bulleted list: start each item with a bold statement. Only write facts that are true and verified."
msgstr "Thẻ thông tin từ danh sách gạch đầu dòng: bắt đầu mỗi mục bằng một câu in đậm. Chỉ viết những điều đúng và đã xác minh."

#: patterns/home-trust.php:17
msgid "Straight answers, no surprises"
msgstr "Trả lời thẳng, không bất ngờ"

#: patterns/home-trust.php:22
msgid "Rental and deposit kept separate"
msgstr "Giá thuê và tiền cọc tách riêng"

#: patterns/home-trust.php:22
msgid "You always know what is paid and what comes back."
msgstr "Bạn luôn biết khoản nào đã trả và khoản nào được hoàn lại."

#: patterns/home-trust.php:26
msgid "Prices confirmed before booking"
msgstr "Giá được xác nhận trước khi đặt"

#: patterns/home-trust.php:26
msgid "Unconfirmed prices are marked, never presented as final."
msgstr "Giá chưa xác nhận được đánh dấu rõ, không bao giờ ghi như giá cuối."

#: patterns/home-trust.php:30
msgid "Bike checked together"
msgstr "Cùng kiểm tra xe"

#: patterns/home-trust.php:30
msgid "Lights, brakes and tyres are checked at hand-over."
msgstr "Đèn, phanh và lốp được kiểm tra khi giao xe."

#: patterns/inner-callout.php
msgctxt "Pattern title"
msgid "Callout (inner pages)"
msgstr "Khung lưu ý (trang con)"

#: patterns/inner-callout.php
msgctxt "Pattern description"
msgid "Highlighted note for guides and service pages: short heading, one or two sentences and an optional checklist."
msgstr "Ghi chú nổi bật cho bài hướng dẫn và trang dịch vụ: tiêu đề ngắn, một hai câu và danh sách kiểm tra tùy chọn."

#: patterns/inner-callout.php:21
msgid "One practical tip that saves the reader time or money."
msgstr "Một mẹo thực tế giúp người đọc tiết kiệm thời gian hoặc tiền."

#: patterns/inner-callout.php:26
msgid "A short, checkable point"
msgstr "Một ý ngắn, dễ kiểm tra"

#: patterns/inner-callout.php:30
msgid "Another short point"
msgstr "Một ý ngắn khác"

