msgstr "Noch keine Sicherungen. Bei der nächsten Änderung wird automatisch eine angelegt."

#: includes/admin/class-admin-business.php:541
msgid "Before a store information change"
msgstr "Vor einer Änderung der Geschäftsdaten"

#: includes/admin/class-admin-business.php:542
msgid "Before a price or vehicle change"
msgstr "Vor einer Preis- oder Fahrzeugänderung"

#: includes/admin/class-admin-business.php:543
msgid "Before an import"
msgstr "Vor einem Import"

#: includes/admin/class-admin-business.php:544
msgid "Before a restore"
msgstr "Vor einer Wiederherstellung"

#: includes/admin/class-admin-business.php:555
msgid "Restore this backup? The current data is backed up first."
msgstr "Diese Sicherung wiederherstellen? Die aktuellen Daten werden zuerst gesichert."

#: includes/admin/class-admin-business.php:555
msgid "Restore"
msgstr "Wiederherstellen"

